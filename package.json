{
  "name": "@tigerdata/bump-release",
  "version": "0.1.0",
  "description": "Bump the package version, tag it, and push to trigger a release",
  "license": "Apache-2.0",
  "author": "TigerData",
  "homepage": "https://tigerdata.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/timescale/bump-release-bun"
  },
  "type": "module",
  "bin": {
    "bump-release": "./src/release.ts"
  },
  "files": [
    "src/release.ts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "lint": "./bun x @biomejs/biome check",
    "test": "./bun test ./src",
    "check": "tsc --noEmit && ./bun --silent lint --write && ./bun --silent run test --only-failures",
    "release": "./bun run src/release.ts"
  },
  "dependencies": {
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2",
    "@types/semver": "^7.7.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
